# Public hostname or static IPv4 address, without https:// or a trailing slash.
DASHBOARD_DOMAIN=replace-me.duckdns.org
# Canonical HTTPS address embedded into reusable customer-scoped collector packages.
# docker-compose.cloud.yml derives it from DASHBOARD_DOMAIN automatically.
DCP_PUBLIC_URL=https://replace-me.duckdns.org

# Use ./Caddyfile.ip only for a public IP certificate; it requires Caddy 2.11+
# and Let's Encrypt's automatically renewed short-lived certificate profile.
DCP_CADDYFILE=./Caddyfile
# Optional for pre-production validation:
# DCP_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-64-character-random-hex-value
# Separately generate with: openssl rand -hex 32
# Keep this stable across redeployments so enrollment and activation retries remain valid.
DCP_ACTIVATION_SECRET=replace-with-a-different-64-character-random-hex-value

# Production customer sessions must only travel over HTTPS.
DASHBOARD_SECURE_COOKIE=1

DCP_BACKUP_TIME=02:00
DCP_BACKUP_TIMEZONE=Asia/Singapore
DCP_BACKUP_RETRY_SECONDS=900
DCP_DAILY_BACKUP_RETENTION_DAYS=14
DCP_MONTHLY_BACKUP_HOST_DIR=./backups/monthly

# Physical-device mode is the safe default. Demo readings remain local.
DCP_DEMO_MODE=0

# Multi-device collection defaults. Keep worker count bounded on site computers.
DCP_MAX_ACTIVE_DEVICES=100
DCP_MAX_COLLECTORS=100
DCP_POLL_WORKERS=8
DCP_OFFLINE_BACKOFF_MAX=300

# Private-network scans requested from the cloud require an explicit opt-in.
DCP_REMOTE_DISCOVERY_ENABLED=0
# Keep short-lived scan evidence bounded; configuration and readings are unaffected.
DCP_DISCOVERY_HISTORY_RETENTION_DAYS=7
# Cloud email alerts; blank host keeps delivery disabled. Never commit credentials.
# TLS is required: starttls (usually 587) or ssl (usually 465).
DCP_SMTP_HOST=
DCP_SMTP_PORT=587
DCP_SMTP_SECURITY=starttls
DCP_SMTP_FROM=
DCP_SMTP_USERNAME=
DCP_SMTP_PASSWORD=
