FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl --fail --show-error --silent \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 tzdata \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt
COPY alarm_config.py auth_service.py cloud_api.py device_lifecycle.py email_api.py email_alerts.py cloud_schema.sql report_i18n.py provision_edge.py provision_customer.py cloud_backup.py backup_scheduler.py archive_cloud_data.py ./
COPY release/ ./release/
RUN mkdir -p public
COPY public/index.html public/device-lifecycle.js public/app.js public/i18n.js public/styles.css public/wallboard.html public/wallboard.css public/wallboard.js ./public/
CMD ["uvicorn", "cloud_api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
